# 复制为 .env 后 docker compose up
NOVAS_MODE=release
NOVAS_JWT_SECRET=change-me-in-production-use-openssl-rand
# 渠道 ApiKey/WebhookSecret 加密密钥（32 字节 base64）：openssl rand -base64 32
NOVAS_DATA_KEY=
NOVAS_COOKIE_SECURE=false
NOVAS_CORS_ORIGINS=http://localhost:3000
SEED_DEMO=true
# Docker Compose 默认由 worker 服务跑定时任务；本地单进程调试可设为 true
NOVAS_EMBEDDED_JOBS=false
POSTGRES_USER=novas
POSTGRES_PASSWORD=novas
POSTGRES_DB=novaspay
