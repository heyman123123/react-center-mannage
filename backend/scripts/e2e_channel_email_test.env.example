# 复制为 e2e_channel_email_test.env 并填入你已经准备好的真实渠道/邮箱账号信息。
# 用法： ./e2e_channel_email_test.sh e2e_channel_email_test.env
#
# 注意：该文件包含真实密钥，请勿提交到 Git（已在 .gitignore 中忽略 *.env）。

# ------------------------------------------------------------------
# 管理端环境
# ------------------------------------------------------------------
ROOT_URL=http://localhost:8080
ADMIN_EMAIL=admin@novaspay.global
ADMIN_PASSWORD=Admin@123456

# ------------------------------------------------------------------
# Creem 支付渠道（在 https://creem.io Sandbox 控制台获取）
# ------------------------------------------------------------------
CREEM_MODE=sandbox
CREEM_API_SECRET=sk_test_your_creem_sandbox_api_secret
CREEM_WEBHOOK_SECRET=
# 可选：若已在 Creem 后台创建商品，填入其 Product ID（prod_xxx），
# 用于 Sandbox 测试下单；留空则脚本会尝试用 sync-from-creem 自动拉取一个。
CREEM_PRODUCT_ID=
CREEM_CUSTOMER_EMAIL=tester@novaspay.global

# ------------------------------------------------------------------
# Resend 邮件渠道（在 https://resend.com 控制台获取）
# ------------------------------------------------------------------
EMAIL_MODE=live
RESEND_API_KEY=re_your_resend_api_key
# 必须是已在 Resend 完成域名校验的发件地址
RESEND_SENDER_EMAIL=notifications@yourdomain.com
RESEND_SENDER_NAME=Novas Notifications
# 用于接收测试邮件的真实邮箱，脚本会校验邮件是否成功投递（返回 messageId）
TEST_RECIPIENT_EMAIL=you@example.com

# ------------------------------------------------------------------
# 行为控制
# ------------------------------------------------------------------
# 测试结束后是否自动删除本次创建的测试渠道
CLEANUP=true
# 若有步骤失败，是否保留现场（不清理），便于排查
KEEP_ON_FAILURE=true
