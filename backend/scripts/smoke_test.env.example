# 复制为 smoke_test.env 并按需填写。CORE 层只需管理端地址与管理员账号。
# 用法： ./smoke_test.sh smoke_test.env
#
# 含真实密钥的 .env 已被 .gitignore 忽略，请勿提交。

# ------------------------------------------------------------------
# 管理端环境（CORE 层必填/可覆盖默认值）
# ------------------------------------------------------------------
ROOT_URL=http://localhost:8080
ADMIN_EMAIL=admin@novaspay.global
ADMIN_PASSWORD=Admin@123456

# ------------------------------------------------------------------
# EXTENDED 层（可选）。任一 Creem / Resend 凭据填了就会尝试对应扩展用例；
# 未填写时脚本以 SKIP 记录，不计入 FAIL。
# ------------------------------------------------------------------
CREEM_API_SECRET=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_CUSTOMER_EMAIL=tester@novaspay.global

RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=Novas Notifications
TEST_RECIPIENT_EMAIL=

# 设为 true 时才会真正调用 Creem 创建测试商品（TC-PROD-001）。默认跳过以免污染沙箱目录。
ALLOW_CREEM_WRITE=false

# 测试结束后是否删除本次创建的数据
CLEANUP=true
